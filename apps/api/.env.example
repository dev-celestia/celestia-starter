# API server port (apps/api/src/index.ts defaults to 4000 if unset)
PORT=4000

# PostgreSQL connection used by @workspace/db and Better Auth
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/celestia

# Better Auth secret (generate one with: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-me

# Google OAuth (optional — only needed for Google sign-in)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
