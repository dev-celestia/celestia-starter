# API server port (apps/api/src/index.ts defaults to 4000 if unset)
PORT=4000

# PostgreSQL connection used by @workspace/db and Better Auth
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/celestia

# Better Auth secret (generate one with: openssl rand -base64 32)
# The server warns when this is missing, set to "replace-me", or under 32 chars.
BETTER_AUTH_SECRET=replace-me

# Public origin(s) allowed to hit auth endpoints (comma-separated).
# Required in any non-local deployment; these localhost defaults apply when unset.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:1212

# Origins allowed by the API's CORS policy (comma-separated).
# Required in any non-local deployment; localhost default applies when unset.
# CORS_ORIGIN=https://your-app.example.com

# Google OAuth (optional — only needed for Google sign-in)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
