{
  "name": "blog",
  "version": "1.0.0",
  "description": "Full CRUD blog: authenticated posts API on the Hono backend plus dashboard management UI, over the typed RPC client",
  "requires": ["auth", "dashboard"],
  "copies": [
    { "from": "api/src/features/blog/routes.ts", "to": "apps/api/src/features/blog/routes.ts" },
    { "from": "web/components/blog/post-form.tsx", "to": "apps/web/components/blog/post-form.tsx" },
    { "from": "web/app/(dashboard)/dashboard/posts/page.tsx", "to": "apps/web/app/(dashboard)/dashboard/posts/page.tsx" },
    { "from": "web/app/(dashboard)/dashboard/posts/new/page.tsx", "to": "apps/web/app/(dashboard)/dashboard/posts/new/page.tsx" },
    { "from": "web/app/(dashboard)/dashboard/posts/[id]/edit/page.tsx", "to": "apps/web/app/(dashboard)/dashboard/posts/[id]/edit/page.tsx" },
    { "from": "ui/components/textarea.tsx", "to": "packages/ui/src/components/textarea.tsx" },
    { "from": "docs/blog.mdx", "to": "apps/web/content/docs/blog.mdx" }
  ],
  "insertions": [
    { "file": "apps/api/src/app.ts", "marker": "imports", "snippet": "snippets/api-imports.ts" },
    { "file": "apps/api/src/app.ts", "marker": "routes", "snippet": "snippets/api-routes.ts" },
    { "file": "packages/db/src/schema.ts", "marker": "tables", "snippet": "snippets/db-schema.ts" },
    { "file": "apps/web/components/dashboard/sidebar.tsx", "marker": "imports", "snippet": "snippets/sidebar-imports.ts" },
    { "file": "apps/web/components/dashboard/sidebar.tsx", "marker": "nav", "snippet": "snippets/sidebar-nav.ts" },
    { "file": "apps/web/content/docs/index.mdx", "marker": "cards", "snippet": "snippets/docs-card.mdx" },
    { "file": "README.md", "marker": "features", "snippet": "snippets/readme-feature.md" }
  ],
  "jsonAppends": [
    { "file": "apps/web/content/docs/meta.json", "path": "pages", "value": "blog" }
  ],
  "dependencies": {
    "apps/api": { "drizzle-orm": "^0.45.2" },
    "apps/web": { "@phosphor-icons/react": "^2.1.10" }
  },
  "postInstall": ["pnpm --filter @workspace/db db:push"],
  "notes": "Creates the posts table (run db:push), adds authenticated CRUD routes to the backend, and a Posts section to the dashboard. Open http://localhost:3000/dashboard/posts."
}
