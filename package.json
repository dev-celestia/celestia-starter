{
  "name": "celestia-starter",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "docs": "turbo dev --filter=web",
    "alpine-ui": "turbo dev --filter=@workspace/alpine-ui",
    "scaffold": "node packages/cli/src/index.js",
    "add-feature": "tsx packages/feature-manager/src/cli/index.ts add",
    "remove-feature": "tsx packages/feature-manager/src/cli/index.ts remove",
    "list-features": "tsx packages/feature-manager/src/cli/index.ts list",
    "prompt-feature": "tsx packages/feature-manager/src/cli/index.ts prompt",
    "publish:packages": "bash scripts/publish.sh",
    "publish:dry-run": "bash scripts/publish.sh --dry-run",
    "publish:ui": "bash scripts/publish.sh --pkg ui",
    "publish:cli": "bash scripts/publish.sh --pkg cli",
    "bump:ui:patch": "bash scripts/publish.sh --pkg ui --bump patch",
    "bump:ui:minor": "bash scripts/publish.sh --pkg ui --bump minor",
    "bump:ui:major": "bash scripts/publish.sh --pkg ui --bump major",
    "bump:cli:patch": "bash scripts/publish.sh --pkg cli --bump patch",
    "bump:cli:minor": "bash scripts/publish.sh --pkg cli --bump minor",
    "bump:cli:major": "bash scripts/publish.sh --pkg cli --bump major"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.19.0",
    "turbo": "^2.9.18",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
