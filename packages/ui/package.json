{
  "name": "@celestia-project/ui",
  "version": "0.3.2",
  "description": "Celestia UI — React component primitives built on Base UI and Tailwind CSS v4",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-celestia/celestia-starter.git",
    "directory": "packages/ui"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@rive-app/react-webgl2": "^4.32.1",
    "@shadcn/react": "^0.2.1",
    "@streamdown/code": "^1.1.1",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/plugin-opener": "^2.2.6",
    "@xyflow/react": "^12.11.3",
    "ai": "^7.0.73",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "media-chrome": "^4.19.2",
    "motion": "^13.1.1",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.54.2",
    "react-jsx-parser": "^2.4.1",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "shadcn": "^4.16.1",
    "shiki": "^4.4.3",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@turbo/gen": "^2.9.15",
    "@types/node": "^20",
    "@types/react": "19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "monaco-editor": "^0.56.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4",
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./globals.css": "./src/styles/globals.css",
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "import": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "import": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "import": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    },
    "./ai": {
      "types": "./src/components/ai/index.ts",
      "import": "./src/components/ai/index.ts",
      "default": "./src/components/ai/index.ts"
    },
    "./components/ai/*": {
      "types": "./src/components/ai/*.tsx",
      "import": "./src/components/ai/*.tsx",
      "default": "./src/components/ai/*.tsx"
    }
  }
}
