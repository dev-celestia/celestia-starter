{
  "name": "cms",
  "version": "1.0.0",
  "description": "Centralized blog content hub for the Celestia app: editorial workflow, markdown block editor, auto-save, revisions, taxonomy, SEO controls, WebP media, soft-locking, public blog, and a CORS-enabled Delivery API (bearer API keys) for external websites",
  "requires": [],
  "copies": [
    {
      "from": "celestia/lib/cms/config.ts",
      "to": "apps/celestia/lib/cms/config.ts"
    },
    {
      "from": "celestia/lib/cms/diff.ts",
      "to": "apps/celestia/lib/cms/diff.ts"
    },
    {
      "from": "celestia/lib/cms/posts.ts",
      "to": "apps/celestia/lib/cms/posts.ts"
