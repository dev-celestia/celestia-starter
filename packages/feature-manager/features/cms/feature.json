  "insertions": [
    {
      "file": "apps/celestia/lib/db/schema.ts",
      "marker": "tables",
      "snippet": "snippets/db-schema.ts"
    },
    {
      "file": "apps/celestia/components/dashboard/sidebar-nav.tsx",
      "marker": "imports",
      "snippet": "snippets/sidebar-imports.ts"
    },
    {
      "file": "apps/celestia/components/dashboard/sidebar-nav.tsx",
      "marker": "nav",
      "snippet": "snippets/sidebar-nav.ts"
    },
    {
      "file": "apps/web/content/docs/index.mdx",
      "marker": "cards",
      "snippet": "snippets/docs-card.mdx"
    },
    {
      "file": "README.md",
      "marker": "features",
      "snippet": "snippets/readme-feature.md"
    }
  ],
  "jsonAppends": [
    {
      "file": "apps/web/content/docs/meta.json",
      "path": "pages",
      "value": "cms"
    }
  ],
  "dependencies": {
    "apps/celestia": {
      "sharp": "^0.34.4",
      "react-markdown": "^10.1.0",
      "remark-gfm": "^4.0.1"
    }
  },
  "postInstall": [
    "pnpm --filter celestia db:push"
  ],
  "notes": "Adds the CMS tables to apps/celestia/lib/db/schema.ts (run db:push), API routes under /api/cms, dashboard pages under /dashboard/cms, and a public blog at /blog. Assign the writer/editor roles from the Users page. The host file apps/celestia/components/dashboard/sidebar-nav.tsx must expose the role prop and the feature-manager imports/nav marker regions (included in this starter)."
}
