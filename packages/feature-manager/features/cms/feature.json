      "to": "apps/celestia/app/api/public/v1/posts/[slug]/route.ts"
    },
    {
      "from": "celestia/app/api/cms/keys/route.ts",
      "to": "apps/celestia/app/api/cms/keys/route.ts"
    },
    {
      "from": "celestia/app/api/cms/keys/[id]/route.ts",
